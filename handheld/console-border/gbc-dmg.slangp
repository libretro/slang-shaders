shaders = 8

shader0 = ../shaders/gameboy/shader-files/gb-0-prep.slang
filter_linear0 = false
scale_type0 = source
scale0 = 1.0
alias0 = GameBoyOpacity

shader1 = ../shaders/gameboy/shader-files/gb-1-match.slang
filter_linear1 = false
scale_type1 = source
scale1 = 1.0
alias1 = GameBoyMatchCorrection

shader2 = ../shaders/gameboy/shader-files/gb-2-dot.slang
filter_linear2 = false
scale_type2 = viewport
scale2 = 1.0
alias2 = GameBoyDot

shader3 = ../shaders/gameboy/shader-files/gb-3-blend.slang
filter_linear3 = false
scale_type3 = source
scale3 = 1.0
alias3 = GameBoyDotMatrixAlphaBlend

shader4 = ../shaders/gameboy/shader-files/gb-4-shadow-horizontal.slang
filter_linear4 = false
scale_type4 = source
scale4 = 1.0

shader5 = ../shaders/gameboy/shader-files/gb-5-shadow-vertical.slang
filter_linear5 = false
scale_type5 = source
scale5 = 1.0

shader6 = ../shaders/gameboy/shader-files/gb-6-composite.slang
filter_linear6 = true
scale_type6 = source
scale6 = 1.0

shader7 = ../shaders/gameboy/shader-files/gb-7-border.slang
filter_linear7 = true
scale_type7 = source
scale7 = 1.0

textures = COLOR_PALETTE;BACKGROUND;BORDER
COLOR_PALETTE = ../shaders/gameboy/resources/sample-palettes/gbp-palette.png
COLOR_PALETTE_linear = false
BACKGROUND = ../shaders/gameboy/resources/sample-bgs/paper-bg.png
BACKGROUND_linear = true
BORDER = resources/color-border-square-4x.png
BORDER_linear = true

video_scale = 4.0
grey_balance = 3.0
response_time = 0.444
blending_mode = 0.0
integer_mode = 2.0
color_toggle = 1.0
