shaders = 8

shader0 = "../motionblur/shaders/feedback.slang"
filter_linear0 = false

shader1 = ../handheld/shaders/authentic_gbc/to_lin_fast.slang
filter_linear1 = false
scale_type1 = source
srgb_framebuffer1 = true
alias1 = PTNativeColour

shader2 = ../handheld/shaders/pixel_transparency/pt-0-shadow-cache.slang
filter_linear2 = false
scale_type2 = source
scale_x2 = 3.1
scale_y2 = 1.1

shader3 = ../handheld/shaders/pixel_transparency/grids/authentic_gbc_fast/cache_x.slang
filter_linear3 = false
scale_type_x3 = viewport
scale_x3 = 1.0
scale_type_y3 = absolute
scale_y3 = 6

shader4 = ../handheld/shaders/pixel_transparency/grids/authentic_gbc_fast/cache_y.slang
filter_linear4 = false
scale_type_y4 = viewport
scale_y4 = 1.0
scale_type_x4 = absolute
scale_x4 = 6

shader5 = ../handheld/shaders/pixel_transparency/grids/authentic_gbc_fast/input.slang
filter_linear5 = false
scale_type5 = viewport
alias5 = LCDInput

shader6 = ../handheld/shaders/pixel_transparency/grids/authentic_gbc_fast/pixel_transparency.slang
filter_linear6 = false
scale_type6 = viewport

shader7 = ../handheld/shaders/frontlit-reflective.slang
filter_linear7 = true
scale_type7 = viewport
float_framebuffer7 = true

PT_SHADOW_OFFSET_X = 1.0
PT_SHADOW_OFFSET_Y = 1.0
PT_PALETTE = 1.0
PT_POLARIZER = 0.0
PT_HIGHLIGHTS = 0.0
textures = "dirt"
dirt = ../handheld/console-border/resources/dirty-glass.png
dirt_linear = true
dirt_wrap_mode = repeat
